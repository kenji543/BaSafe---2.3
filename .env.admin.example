GEOSAFE_HOST=127.0.0.1
GEOSAFE_PORT=8001
GEOSAFE_DB_PATH=data/admin-dev.db
GEOSAFE_RUNTIME_DATA_MODE=snapshot
GEOSAFE_ADMIN_ENABLED=true
GEOSAFE_ADMIN_USERNAME=admin
GEOSAFE_ADMIN_PASSWORD=replace-with-a-long-local-password
GEOSAFE_ADMIN_LOGIN_ATTEMPTS_PER_MINUTE=10
GEOSAFE_ADMIN_SESSION_MINUTES=480
GEOSAFE_VISITOR_ANALYTICS_ENABLED=true
GEOSAFE_ADMIN_UPLOAD_ROOT=data/admin-uploads
GEOSAFE_LOG_LEVEL=INFO
